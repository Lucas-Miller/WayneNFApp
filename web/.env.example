# Base URL the browser uses to reach the Go API.
# Dev default goes through the Vite proxy (see vite.config.ts); set the full URL for production builds.
VITE_API_BASE_URL=/api

# Google Maps JavaScript API key (needs "Maps JavaScript API" and "Directions API" enabled).
# Restrict it to your site's HTTP referrers in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for advanced markers. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Where the dev proxy forwards /api requests (e.g. http://localhost:8080 for a local backend).
API_PROXY_TARGET=https://wayneapi.lucasmiller.dev
